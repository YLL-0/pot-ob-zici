# Vse spremenljivke so izbirne. Brez te datoteke (preimenovane v .env.local)
# aplikacija teče v načinu "seed" — bere iz tocke.seed.json namesto iz Supabase.
# lib/data.ts preklopi na Supabase samo, če je NEXT_PUBLIC_SUPABASE_URL nastavljen.

# --- Supabase ---
# Javna URL in anon ključ projekta (varna za brskalnik).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role ključ — SAMO za scripts/seed.ts in admin API poti. Nikoli v komponentah/brskalniku.
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenRouteService (peš navigacija) ---
# Uporablja se izključno strežniško v app/api/route/route.ts — nikoli v odjemalcu.
ORS_API_KEY=

# --- Osnovni URL projekta ---
# Edini vir resnice za QR-URL-je (qr_url = NEXT_PUBLIC_BASE_URL + id).
# Zrcali polje "Osnovni URL QR" v Excelovem zavihku "Nastavitve".
NEXT_PUBLIC_BASE_URL=https://novomestovzici.si
