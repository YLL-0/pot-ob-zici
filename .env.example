# Vse spremenljivke so izbirne. Brez te datoteke (preimenovane v .env.local)
# aplikacija teče v načinu "seed" — bere iz tocke.seed.json namesto iz Supabase.
# lib/data.ts preklopi na Supabase samo, če je NEXT_PUBLIC_SUPABASE_URL nastavljen.

# --- Supabase ---
# Javna URL in anon ključ projekta (varna za brskalnik).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role ključ — SAMO za scripts/seed.ts in admin API poti. Nikoli v komponentah/brskalniku.
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenRouteService (peš navigacija) ---
# Uporablja se izključno strežniško v app/api/route/route.ts — nikoli v odjemalcu.
ORS_API_KEY=

# --- Osnovni URL projekta ---
# Edini vir resnice za QR-URL-je (qr_url = NEXT_PUBLIC_BASE_URL + id).
# Zrcali polje "Osnovni URL QR" v Excelovem zavihku "Nastavitve".
NEXT_PUBLIC_BASE_URL=https://novomestovzici.si

# --- Payload CMS (urejanje vsebin, /admin) ---
# Brez teh dveh je admin izklopljen ("Urejanje ni na voljo"), javna stran
# pa bere tocke.seed.json.
# Supabase → Connect → Session pooler URI (z geslom baze).
DATABASE_URI=
# Naključni niz ≥ 32 znakov, npr. `openssl rand -hex 32`.
PAYLOAD_SECRET=
# Absolutni URL aplikacije (povezave v adminu), npr. http://localhost:3000
NEXT_PUBLIC_SERVER_URL=

# --- Supabase Storage prek S3 (fotografije v adminu) ---
# Storage → Settings → S3 Connection / S3 Access Keys; bucket mora biti javen.
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# --- E-pošta za urejevalnik (Resend): ponastavitev gesla, povabila novim uporabnikom ---
# Brez teh dveh Payload sporočila le izpiše v strežniški dnevnik — nikomur jih ne pošlje.
# Ključ: resend.com → API Keys (dovoljenje »Sending access«).
RESEND_API_KEY=
# Naslov pošiljatelja na domeni, potrjeni v Resendu (Domains), npr. urejanje@vasa-domena.si
EMAIL_FROM=
# Neobvezno; privzeto »Pot ob žici«
EMAIL_FROM_NAME=
# Povezave v sporočilih kažejo na NEXT_PUBLIC_SERVER_URL (zgoraj) — v produkciji naj bo pravi javni naslov.
